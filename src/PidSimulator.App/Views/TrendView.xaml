<UserControl x:Class="PidSimulator.App.Views.TrendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" TextElement.FontSize="12.5">
            <CheckBox x:Name="ChkSp" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <Line X1="0" X2="16" Y1="0" Y2="0" Stroke="{StaticResource SeriesSpBrush}" StrokeThickness="2.5" StrokeDashArray="2 1.2" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="SP"/>
                </StackPanel>
            </CheckBox>
            <CheckBox x:Name="ChkPv" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <Line X1="0" X2="16" Y1="0" Y2="0" Stroke="{StaticResource SeriesPvBrush}" StrokeThickness="2.5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="PV"/>
                </StackPanel>
            </CheckBox>
            <CheckBox x:Name="ChkMv" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <Line X1="0" X2="16" Y1="0" Y2="0" Stroke="{StaticResource SeriesMvBrush}" StrokeThickness="2.5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="MV"/>
                </StackPanel>
            </CheckBox>
            <Rectangle Width="1" Height="22" Fill="{StaticResource LineBrush}" Margin="4,0,14,0"/>
            <TextBlock Text="時間軸" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="CmbWindow" Width="78" SelectedIndex="2" SelectionChanged="Option_Changed" Margin="0,0,12,0">
                <ComboBoxItem Content="30秒" Tag="30"/>
                <ComboBoxItem Content="1分" Tag="60"/>
                <ComboBoxItem Content="2分" Tag="120"/>
                <ComboBoxItem Content="5分" Tag="300"/>
                <ComboBoxItem Content="10分" Tag="600"/>
                <ComboBoxItem Content="30分" Tag="1800"/>
                <ComboBoxItem Content="60分" Tag="3600"/>
                <ComboBoxItem Content="120分" Tag="7200"/>
                <ComboBoxItem Content="240分" Tag="14400"/>
            </ComboBox>
            <TextBlock Text="PV軸" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="CmbY" Width="96" SelectedIndex="0" SelectionChanged="Option_Changed" Margin="0,0,12,0">
                <ComboBoxItem Content="レンジ固定"/>
                <ComboBoxItem Content="自動"/>
            </ComboBox>
            <ToggleButton x:Name="BtnPause" Style="{StaticResource ToggleBtnSmall}" Content="❚❚ 一時停止" Checked="Pause_Changed" Unchecked="Pause_Changed" Margin="0,0,6,0"/>
            <Button Style="{StaticResource BtnSmall}" Content="履歴クリア" Click="Clear_Click" Margin="0,0,12,0"/>
            <Button Style="{StaticResource BtnSmall}" Content="CSVエクスポート…" Command="{Binding ExportCsvCommand}" Margin="0,0,12,0"
                    ToolTip="保持している全履歴を時刻・SP・PV・MV・外乱・FORCE・通信状態のCSVで保存します。保持時間は共通設定で変更できます。"/>
            <TextBlock x:Name="PauseHint" Style="{StaticResource Hint}" VerticalAlignment="Center" Visibility="Collapsed"
                       Text="一時停止中：ホイールで拡大・縮小、ドラッグで移動できます（記録は継続）"/>
        </WrapPanel>

        <WrapPanel DockPanel.Dock="Bottom" Margin="2,6,0,0" TextElement.FontSize="12">
            <TextBlock x:Name="RoLabel" Style="{StaticResource Hint}" Margin="0,0,4,0"/>
            <TextBlock x:Name="RoTime" FontFamily="{StaticResource MonoFont}" Margin="0,0,16,0"/>
            <TextBlock Foreground="{StaticResource SeriesSpBrush}" Margin="0,0,16,0"><Run Text="SP "/><Run x:Name="RoSp" FontFamily="{StaticResource MonoFont}"/></TextBlock>
            <TextBlock Foreground="{StaticResource SeriesPvBrush}" Margin="0,0,16,0"><Run Text="PV "/><Run x:Name="RoPv" FontFamily="{StaticResource MonoFont}"/></TextBlock>
            <TextBlock Foreground="{StaticResource SeriesMvBrush}" Margin="0,0,16,0"><Run Text="MV "/><Run x:Name="RoMv" FontFamily="{StaticResource MonoFont}"/></TextBlock>
            <TextBlock Foreground="{StaticResource Ink2Brush}" Margin="0,0,16,0"><Run Text="外乱 "/><Run x:Name="RoDist" FontFamily="{StaticResource MonoFont}"/></TextBlock>
            <Border x:Name="RoForce" Background="{StaticResource ForceBgBrush}" BorderBrush="{StaticResource ForceLineBrush}" BorderThickness="1"
                    CornerRadius="9" Padding="7,0" Visibility="Collapsed" Margin="0,0,16,0">
                <TextBlock Text="FORCE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource ForceBrush}"/>
            </Border>
            <TextBlock Style="{StaticResource Hint}" Text="左軸 SP/PV・右軸 MV・黄色帯 = FORCE中"/>
        </WrapPanel>

        <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="1" CornerRadius="3" Background="White">
            <sp:WpfPlot x:Name="Plot" MouseMove="Plot_MouseMove" MouseLeave="Plot_MouseLeave"/>
        </Border>
    </DockPanel>
</UserControl>
