<Window x:Class="PidSimulator.App.Views.RegistrationWindow"
        Icon="/Assets/AppIcon.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PidSimulator.App.ViewModels"
        xmlns:models="clr-namespace:PidSimulator.Core.Models;assembly=PidSimulator.Core"
        Title="{Binding WindowTitle}" Width="960" Height="700" MinWidth="800" MinHeight="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource SurfaceBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource InkBrush}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,12"/>
        </Style>
        <Style x:Key="FormRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="StepHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="StepLead" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="UiText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        </Style>
        <Style x:Key="Num" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="96"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <DataTemplate x:Key="RangeRow" DataType="{x:Type vm:RangeRowViewModel}">
            <Border Padding="8,6" BorderBrush="{StaticResource Line2Brush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/><ColumnDefinition Width="112"/><ColumnDefinition Width="84"/><ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="84"/><ColumnDefinition Width="84"/><ColumnDefinition Width="72"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Direction}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="2" Width="76" HorizontalAlignment="Left" TextAlignment="Right" Text="{Binding RawMin, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Column="3" Width="76" HorizontalAlignment="Left" TextAlignment="Right" Text="{Binding RawMax, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Column="4" Width="76" HorizontalAlignment="Left" TextAlignment="Right" Text="{Binding EngMin, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Column="5" Width="76" HorizontalAlignment="Left" TextAlignment="Right" Text="{Binding EngMax, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Grid.Column="6" Width="62" HorizontalAlignment="Left" Style="{StaticResource UiText}" IsReadOnly="{Binding CanEditUnit, Converter={StaticResource InvBool}}" Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock x:Name="pv" Grid.Column="7" Text="{Binding Preview}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                               Foreground="{StaticResource Ink3Brush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsValid}" Value="False">
                    <Setter TargetName="pv" Property="Foreground" Value="{StaticResource AlarmBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ヘッダ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <StackPanel>
                <TextBlock Text="{Binding WindowTitle}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SubTitle}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- フッタ -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="キャンセル" IsCancel="True" MinWidth="88"/>
                    <Button Content="戻る" Command="{Binding BackCommand}" MinWidth="88" Margin="8,0,0,0"
                            Visibility="{Binding IsFirstStep, Converter={StaticResource InvBoolToVis}}"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="次へ" Command="{Binding NextCommand}" MinWidth="88" Margin="8,0,0,0" IsDefault="True"
                            Visibility="{Binding IsLastStep, Converter={StaticResource InvBoolToVis}}"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="{Binding FinishLabel}" Command="{Binding FinishCommand}" MinWidth="100" Margin="8,0,0,0"
                            IsEnabled="{Binding CanFinish}" Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <TextBlock Text="{Binding StepCaption}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource AlarmBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ステップ一覧 -->
        <Border DockPanel.Dock="Left" Width="196" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="8,12">
            <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StepItem}">
                        <Button x:Name="b" Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                IsEnabled="{Binding IsReachable}" Style="{StaticResource BtnGhost}" HorizontalContentAlignment="Left" Height="34" Padding="8,0" Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="22" Height="22" Margin="0,0,10,0">
                                    <Ellipse x:Name="c" Fill="{StaticResource SurfaceBrush}" Stroke="{StaticResource LineBrush}"/>
                                    <TextBlock x:Name="n" Text="{Binding Number}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Ink2Brush}"/>
                                </Grid>
                                <TextBlock x:Name="t" Text="{Binding Name}" VerticalAlignment="Center" Foreground="{StaticResource Ink2Brush}"/>
                            </StackPanel>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter TargetName="n" Property="Text" Value="✓"/>
                                <Setter TargetName="n" Property="Foreground" Value="{StaticResource RunBrush}"/>
                                <Setter TargetName="c" Property="Stroke" Value="#9CCBAE"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentWeakBrush}"/>
                                <Setter TargetName="c" Property="Fill" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="c" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="n" Property="Foreground" Value="White"/>
                                <Setter TargetName="t" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="t" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,20,26,20">
            <Grid>
                <!-- 2. 基本設定 -->
                <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource IndexToVis}, ConverterParameter=1}">
                    <TextBlock Text="基本設定" Style="{StaticResource StepHeading}"/>
                    <TextBlock Text="一覧カードに表示する名前と説明を設定します。" Style="{StaticResource StepLead}"/>
                    <TextBlock Margin="0,0,0,16" TextWrapping="Wrap"><Run Text="選択したモデル："/><Run Text="{Binding SelectedModel.Name, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource FormLabel}"><Run Text="制御名称"/><Run Text=" *" Foreground="{StaticResource AlarmBrush}"/></TextBlock>
                        <TextBox Grid.Column="1" Style="{StaticResource UiText}" Width="440" HorizontalAlignment="Left" Margin="0,0,0,4"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,0,0,12" TextWrapping="Wrap"
                                   Text="先頭に計装タグ（例: TIC-601）を付けると、カードの丸いタグ表示に使われます。"/>
                        <TextBlock Grid.Row="2" Text="説明・メモ" Style="{StaticResource FormLabel}" VerticalAlignment="Top" Margin="0,6,14,12"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource UiText}" Width="440" HorizontalAlignment="Left" Height="72" Padding="6,4" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,0,0,12" Text="{Binding Description}"/>
                    </Grid>
                </StackPanel>

                <!-- 1. モデル選択 -->
                <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource IndexToVis}, ConverterParameter=0}">
                    <TextBlock Text="モデル選択" Style="{StaticResource StepHeading}"/>
                    <TextBlock Text="制御対象の動特性を選びます。モデルを変えると、レンジ・初期値・パラメータがそのモデルの標準値になります。" Style="{StaticResource StepLead}"/>
                    <ListBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,8"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                                <GroupStyle.Panel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </GroupStyle.Panel>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,10,10"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Width="236" Padding="12,10" CornerRadius="4" BorderThickness="1"
                                                    BorderBrush="{StaticResource LineBrush}" Background="{StaticResource SurfaceBrush}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                                    <Setter TargetName="bd" Property="Padding" Value="11,9"/>
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentWeakBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ModelInfo}">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,10,0" VerticalAlignment="Top">
                                        <Ellipse Stroke="{StaticResource Ink2Brush}" StrokeThickness="1.5" Fill="{StaticResource SurfaceBrush}"/>
                                        <Rectangle Height="1" Fill="{StaticResource Ink2Brush}" VerticalAlignment="Center" Margin="1,0"/>
                                        <TextBlock Text="{Binding Isa}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0"/>
                                        <TextBlock Text="—" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Ink2Brush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,7"/>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                        <TextBlock Style="{StaticResource Hint}" FontSize="11.5" TextWrapping="Wrap"><Run Text="MV: "/><Run Text="{Binding MvLabel, Mode=OneWay}"/></TextBlock>
                                        <TextBlock Style="{StaticResource Hint}" FontSize="11.5" TextWrapping="Wrap"><Run Text="PV: "/><Run Text="{Binding PvLabel, Mode=OneWay}"/><Run Text=" ["/><Run Text="{Binding Unit, Mode=OneWay}"/><Run Text="]"/></TextBlock>
                                        <TextBlock Text="{Binding ResponseDirection}" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource Ink2Brush}" Margin="0,4,0,0"/>
                                        <TextBlock Style="{StaticResource Hint}" FontSize="11.5" TextWrapping="Wrap"><Run Text="外乱: "/><Run Text="{Binding DistLabel, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Background="{StaticResource ForceBgBrush}" BorderBrush="{StaticResource ForceLineBrush}" BorderThickness="1" CornerRadius="3" Padding="10,6" Margin="0,6,0,0"
                            Visibility="{Binding ModelChanged, Converter={StaticResource BoolToVis}}">
                        <TextBlock Foreground="{StaticResource ForceBrush}" TextWrapping="Wrap"
                                   Text="モデルを変更すると、保存時にパラメータが標準値に戻り、トレンド履歴は消去されます。"/>
                    </Border>
                </StackPanel>

                <!-- 4. PLC通信設定 -->
                <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource IndexToVis}, ConverterParameter=3}">
                    <TextBlock Text="PLC通信設定" Style="{StaticResource StepHeading}"/>
                    <TextBlock Text="MVとSPはPLCから読み込み、PVはPLCへ書き込みます。PVの書込先は特に確認してください。" Style="{StaticResource StepLead}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource FormLabel}"><Run Text="MVアドレス（読込）"/><Run Text=" *" Foreground="{StaticResource AlarmBrush}"/></TextBlock>
                        <StackPanel Grid.Column="1" Style="{StaticResource FormRow}">
                            <TextBox Width="140" Text="{Binding MvAddress, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0" Text="PLC → シミュレータ"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}"><Run Text="PVアドレス（書込）"/><Run Text=" *" Foreground="{StaticResource AlarmBrush}"/></TextBlock>
                        <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource FormRow}">
                            <TextBox Width="140" BorderBrush="{StaticResource AlarmBrush}" FontWeight="Bold" Text="{Binding PvAddress, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Foreground="{StaticResource AlarmBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" Text="シミュレータ → PLC　書込先"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="SPアドレス（読込）" Style="{StaticResource FormLabel}"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Style="{StaticResource FormRow}">
                            <TextBox Width="140" Text="{Binding SpAddress, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseSp}"/>
                            <CheckBox Content="PLCからSPを読み込む" IsChecked="{Binding UseSp}" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="{Binding DataTypeLabel}" Style="{StaticResource FormLabel}"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Style="{StaticResource FormRow}">
                            <ComboBox Width="140" ItemsSource="{Binding DataTypes}" SelectedItem="{Binding DataType}"/>
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Margin="0,6,0,0">
                        <StackPanel>
                            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="読込テスト実行" Command="{Binding ReadTestCommand}"/>
                                    <TextBlock Text="接続テスト" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="制御開始前に、読込値・データ型・スケーリングを確認します" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <StackPanel Margin="10">
                                <ItemsControl ItemsSource="{Binding TestRows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TestRow}">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44"/><ColumnDefinition Width="90"/><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/><ColumnDefinition Width="140"/><ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Signal}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Address}" FontFamily="{StaticResource MonoFont}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding DataType}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Ink3Brush}"/>
                                                <TextBlock Grid.Column="3" FontFamily="{StaticResource MonoFont}"><Run Text="RAW " Foreground="{StaticResource Ink3Brush}"/><Run Text="{Binding Raw, Mode=OneWay}"/></TextBlock>
                                                <TextBlock Grid.Column="4" Text="{Binding Eng}" FontFamily="{StaticResource MonoFont}"/>
                                                <TextBlock x:Name="r" Grid.Column="5" Text="{Binding Result}" FontWeight="SemiBold" Foreground="{StaticResource RunBrush}"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Ok}" Value="False">
                                                    <Setter TargetName="r" Property="Foreground" Value="{StaticResource AlarmBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding TestSummary}" Style="{StaticResource Hint}" TextWrapping="Wrap"/>

                                <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="4" Background="{StaticResource AlarmBgBrush}" BorderBrush="{StaticResource AlarmBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <WrapPanel>
                                            <TextBlock Text="PV書込テスト" FontWeight="Bold" Foreground="{StaticResource AlarmBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <CheckBox IsChecked="{Binding PvWriteAck}" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock><Run Text="{Binding PvAddress, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontWeight="Bold"/><Run Text=" へ実際に書き込むことを確認しました"/></TextBlock>
                                            </CheckBox>
                                            <TextBox Width="86" TextAlignment="Right" Text="{Binding PvTestValue}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding PvUnit}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Button Style="{StaticResource BtnDanger}" Height="26" FontSize="12" Padding="9,0" Content="書込テスト"
                                                    Command="{Binding PvWriteTestCommand}" IsEnabled="{Binding PvWriteAck}"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding PvTestResult}" FontSize="12" Foreground="{StaticResource AlarmBrush}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 3. レンジ設定 -->
                <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource IndexToVis}, ConverterParameter=2}">
                    <TextBlock Text="レンジ設定" Style="{StaticResource StepHeading}"/>
                    <CheckBox IsChecked="{Binding MvOnOff}" Content="MVをON/OFF（リレー）で受け取る（チェックなし：連続値）" Margin="0,10,0,6"/>
                    <TextBlock Text="ON/OFFはM・Yなどのビット、またはD1.0形式を読み込み、OFF=0%、ON=100%として扱います。SSRの高速パルス制御は対象外です。"
                               TextWrapping="Wrap" Foreground="{StaticResource Ink2Brush}" Margin="0,0,0,12"/>
                    <TextBlock Text="PLCのRAW値と工業値の対応を設定します。例: RAW 0～4000 ⇔ 0～100 %" Style="{StaticResource StepLead}"/>
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding MvOnOff, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="MV単位" Width="90" VerticalAlignment="Center"/>
                            <ComboBox Width="120" ItemsSource="{Binding MvUnits}" SelectedItem="{Binding MvUnit}"/>
                            <TextBlock Text="選択後、下の表で最小・最大を調整できます" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding MvScalingHint}" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,12" Visibility="{Binding IsLevelModel, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="液面の単位" Width="90" VerticalAlignment="Center"/>
                            <ComboBox Width="120" ItemsSource="{Binding LevelPvUnits}" SelectedItem="{Binding LevelPvUnit}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LevelUnitHint}" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="3">
                        <StackPanel>
                            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                                <Grid TextElement.FontSize="12" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource Ink2Brush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/><ColumnDefinition Width="112"/><ColumnDefinition Width="84"/><ColumnDefinition Width="84"/>
                                        <ColumnDefinition Width="84"/><ColumnDefinition Width="84"/><ColumnDefinition Width="72"/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="信号"/><TextBlock Grid.Column="1" Text="方向"/><TextBlock Grid.Column="2" Text="RAW 最小"/><TextBlock Grid.Column="3" Text="RAW 最大"/>
                                    <TextBlock Grid.Column="4" Text="工業値 最小"/><TextBlock Grid.Column="5" Text="工業値 最大"/><TextBlock Grid.Column="6" Text="単位"/><TextBlock Grid.Column="7" Text="換算例"/>
                                </Grid>
                            </Border>
                            <ContentControl Content="{Binding MvRange}" ContentTemplate="{StaticResource RangeRow}" Focusable="False" Visibility="{Binding MvOnOff, Converter={StaticResource InvBoolToVis}}"/>
                            <TextBlock Text="MV　OFF（0）→ 0%　／　ON（1）→ 100%" Margin="12" Visibility="{Binding MvOnOff, Converter={StaticResource BoolToVis}}"/>
                            <ContentControl Content="{Binding PvRange}" ContentTemplate="{StaticResource RangeRow}" Focusable="False"/>
                            <ContentControl Content="{Binding SpRange}" ContentTemplate="{StaticResource RangeRow}" Focusable="False"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,12,0,0">
                        <TextBlock FontSize="12" Foreground="{StaticResource Ink2Brush}" TextWrapping="Wrap"
                                   Text="書込み時は工業値レンジ外のPVを最小値／最大値に制限し、NaN・Infinity は書き込みません（異常として記録します）。"/>
                    </Border>
                </StackPanel>

                <!-- 5. 初期値・異常時 -->
                <Grid Visibility="{Binding StepIndex, Converter={StaticResource IndexToVis}, ConverterParameter=4}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Grid.ColumnSpan="3" Text="初期値・停止時・異常時の動作" Style="{StaticResource StepHeading}"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="リセットするとこの初期状態に戻ります。同じ条件から試験を繰り返すときに使います。" Style="{StaticResource StepLead}"/>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="初期状態" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Style="{StaticResource FormRow}">
                            <TextBlock Text="初期PV" Width="70" VerticalAlignment="Center" Foreground="{StaticResource Ink2Brush}"/>
                            <TextBox Style="{StaticResource Num}" Text="{Binding InitialPv}"/>
                            <TextBlock Text="{Binding PvUnit}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FormRow}">
                            <TextBlock Text="初期SP" Width="70" VerticalAlignment="Center" Foreground="{StaticResource Ink2Brush}"/>
                            <TextBox Style="{StaticResource Num}" Text="{Binding InitialSp}"/>
                            <TextBlock Text="{Binding PvUnit}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,16"
                                   Text="PLCからSPを読み込む場合、初期SPは読込前の表示値としてだけ使われます。"/>

                        <TextBlock Text="停止時のPV" Style="{StaticResource SectionTitle}"/>
                        <RadioButton GroupName="stop" Content="最終値保持" IsChecked="{Binding StopPv, Converter={StaticResource EnumEq}, ConverterParameter=Hold}"/>
                        <RadioButton GroupName="stop" Content="初期値へ戻す" IsChecked="{Binding StopPv, Converter={StaticResource EnumEq}, ConverterParameter=Initial}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="stop" Content="指定値へ戻す" IsChecked="{Binding StopPv, Converter={StaticResource EnumEq}, ConverterParameter=Value}" Margin="0,0,10,0"/>
                            <TextBox Style="{StaticResource Num}" Width="80" Text="{Binding StopPvValue}" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding PvUnit}" Style="{StaticResource Hint}" Margin="6,5,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="PLC通信異常時" Style="{StaticResource SectionTitle}"/>
                        <RadioButton GroupName="err" Content="シミュレーション停止" IsChecked="{Binding OnCommError, Converter={StaticResource EnumEq}, ConverterParameter=StopSimulation}"/>
                        <RadioButton GroupName="err" Content="MV最終値保持" IsChecked="{Binding OnCommError, Converter={StaticResource EnumEq}, ConverterParameter=HoldMv}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="err" Content="MVを安全値へ変更" IsChecked="{Binding OnCommError, Converter={StaticResource EnumEq}, ConverterParameter=SafeMv}" Margin="0,0,10,0"/>
                            <TextBox Style="{StaticResource Num}" Width="70" Text="{Binding SafeMv}" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding MvUnit}" Style="{StaticResource Hint}" Margin="6,5,0,0"/>
                        </StackPanel>
                        <RadioButton GroupName="err" Content="PV書込み停止" IsChecked="{Binding OnCommError, Converter={StaticResource EnumEq}, ConverterParameter=StopPvWrite}"/>

                        <TextBlock Text="復旧時" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/>
                        <RadioButton GroupName="rec" Content="自動再開" IsChecked="{Binding Recover, Converter={StaticResource EnumEq}, ConverterParameter=Auto}"/>
                        <RadioButton GroupName="rec" Content="手動再開（確認してから再開）" IsChecked="{Binding Recover, Converter={StaticResource EnumEq}, ConverterParameter=Manual}"/>
                    </StackPanel>
                </Grid>

                <!-- 6. 確認 -->
                <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource IndexToVis}, ConverterParameter=5}">
                    <TextBlock Text="確認" Style="{StaticResource StepHeading}"/>
                    <TextBlock Text="登録内容と設定チェックの結果を確認してください。" Style="{StaticResource StepLead}"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
                        </Grid.Resources>
                        <TextBlock Text="制御名称" Foreground="{StaticResource Ink3Brush}"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Text="モデル" Foreground="{StaticResource Ink3Brush}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SummaryModel}"/>
                        <TextBlock Grid.Row="2" Text="アドレス" Foreground="{StaticResource Ink3Brush}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SummaryAddress}" FontFamily="{StaticResource MonoFont}"/>
                        <TextBlock Grid.Row="3" Text="PVレンジ" Foreground="{StaticResource Ink3Brush}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SummaryRange}" FontFamily="{StaticResource MonoFont}"/>
                        <TextBlock Grid.Row="4" Text="初期値" Foreground="{StaticResource Ink3Brush}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SummaryInitial}"/>
                        <TextBlock Grid.Row="5" Text="停止時・異常時" Foreground="{StaticResource Ink3Brush}"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SummaryBehavior}"/>
                    </Grid>
                    <TextBlock Text="設定チェック" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding Checks}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="b" CornerRadius="3" Padding="10,6" Margin="0,0,0,6" Background="{StaticResource AlarmBgBrush}">
                                    <TextBlock x:Name="t" TextWrapping="Wrap" Foreground="{StaticResource AlarmBrush}" FontSize="12.5">
                                        <Run x:Name="mark" Text="!"/><Run Text="　"/><Run Text="{Binding Message, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="Ok">
                                        <Setter TargetName="b" Property="Background" Value="{StaticResource RunBgBrush}"/>
                                        <Setter TargetName="t" Property="Foreground" Value="{StaticResource RunBrush}"/>
                                        <Setter TargetName="mark" Property="Text" Value="✓"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Block">
                                        <Setter TargetName="b" Property="Background" Value="{StaticResource AlarmBrush}"/>
                                        <Setter TargetName="t" Property="Foreground" Value="White"/>
                                        <Setter TargetName="mark" Property="Text" Value="×"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox IsChecked="{Binding Acknowledged}" Margin="0,6,0,0" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}"
                              IsEnabled="{Binding HasBlockers, Converter={StaticResource InvBool}}">
                        <TextBlock Text="警告内容を確認し、このまま保存する" FontWeight="SemiBold"/>
                    </CheckBox>
                    <TextBlock Text="赤い項目を修正するまで登録できません。左のステップから該当箇所に戻れます。" Foreground="{StaticResource AlarmBrush}" Margin="0,6,0,0"
                               Visibility="{Binding HasBlockers, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
