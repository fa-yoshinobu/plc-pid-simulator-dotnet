<Window x:Class="PidSimulator.App.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" SizeToContent="Height" Width="480"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource InkBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="14,9" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <DockPanel>
                <Grid x:Name="Glyph" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Ellipse x:Name="GlyphCircle" Fill="{StaticResource AccentBrush}"/>
                    <TextBlock x:Name="GlyphText" Text="i" Foreground="White" FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,10">
            <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right"/>
        </Border>
        <StackPanel Margin="18,16,18,18">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="21"/>
            <ItemsControl x:Name="ItemList" Margin="0,10,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="b" CornerRadius="3" Padding="10,6" Margin="0,0,0,6" Background="{StaticResource AlarmBgBrush}">
                            <TextBlock x:Name="t" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource AlarmBrush}" FontSize="12.5"/>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Ok">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource RunBgBrush}"/>
                                <Setter TargetName="t" Property="Foreground" Value="{StaticResource RunBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Block">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AlarmBrush}"/>
                                <Setter TargetName="t" Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DockPanel>
</Window>
