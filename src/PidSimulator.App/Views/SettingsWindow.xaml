<Window x:Class="PidSimulator.App.Views.SettingsWindow"
        Icon="/Assets/AppIcon.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PidSimulator.App.Controls"
        Title="共通設定" Width="760" Height="620" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource SurfaceBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource InkBrush}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <controls:BoolEqualsConverter x:Key="RadioBool"/>
        <controls:EnumEqualsConverter x:Key="RadioMode"/>
        <Style x:Key="L" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,12"/>
        </Style>
        <Style x:Key="Row" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="キャンセル" IsCancel="True" MinWidth="88"/>
                <Button Style="{StaticResource BtnPrimary}" Content="保存" Command="{Binding SaveCommand}" IsEnabled="{Binding TrendMinutesValid}" MinWidth="88" Margin="8,0,0,0" IsDefault="True"/>
            </StackPanel>
        </Border>
        <TabControl Margin="16,14,16,14" SelectedIndex="{Binding SelectedTab}" Padding="18,16">
            <TabItem Header="PLC接続設定">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="保存では通信を開始しません。保存後、メイン画面の「接続」を押してください。接続テストは一時的に通信し、終了後に切断します。"/>
                    <TextBlock Text="接続方式" Style="{StaticResource SectionTitle}"/>
                    <RadioButton GroupName="mode" IsChecked="{Binding Mode, Mode=TwoWay, Converter={StaticResource RadioMode}, ConverterParameter=Dummy}" Margin="0,0,0,6">
                        <TextBlock><Run Text="ダミーPLC" FontWeight="SemiBold"/><Run Text="　PLCなしで動作確認（PLC側のPIDも模擬）" Foreground="{StaticResource Ink3Brush}"/></TextBlock>
                    </RadioButton>
                    <RadioButton GroupName="mode" IsChecked="{Binding Mode, Mode=TwoWay, Converter={StaticResource RadioMode}, ConverterParameter=Slmp}" Margin="0,0,0,6">
                        <TextBlock><Run Text="MELSEC PLC（SLMP）" FontWeight="SemiBold"/><Run Text="　実機・GX Simulator 3" Foreground="{StaticResource Ink3Brush}"/></TextBlock>
                    </RadioButton>
                    <RadioButton GroupName="mode" IsChecked="{Binding Mode, Mode=TwoWay, Converter={StaticResource RadioMode}, ConverterParameter=HostLink}" Margin="0,0,0,14">
                        <TextBlock><Run Text="KEYENCE PLC（Host Link）" FontWeight="SemiBold"/><Run Text="　実機・KV STUDIO Simulator" Foreground="{StaticResource Ink3Brush}"/></TextBlock>
                    </RadioButton>

                    <Grid IsEnabled="{Binding UseRealPlc}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="PLC機種" Style="{StaticResource L}"/>
                        <StackPanel Grid.Column="1" Style="{StaticResource Row}">
                            <ComboBox Width="280" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayName"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" Visibility="{Binding CanUseKvSimulator, Converter={StaticResource BoolToVis}}">
                            <CheckBox IsChecked="{Binding UseKvSimulator}" Content="KV STUDIO Simulator に接続" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="22,4,0,0"
                                       Text="KV STUDIO でシミュレータを起動してください。127.0.0.1:8501 / TCP に固定します。"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" Visibility="{Binding CanUseGxSimulator, Converter={StaticResource BoolToVis}}">
                            <CheckBox IsChecked="{Binding UseGxSimulator}" Content="GX Simulator 3 に接続" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="22,4,0,0"
                                       Text="127.0.0.1:5511 / TCP に固定します。GX Works3 でシミュレーションを開始し、CPUパラメータ「RUN中の書込み許可/禁止設定」を「一括で許可する(SLMP)」にしてください。"/>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="IPアドレス" Style="{StaticResource L}"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Style="{StaticResource Row}" IsEnabled="{Binding EndpointEditable}"><TextBox Width="180" Text="{Binding Host}"/></StackPanel>
                        <TextBlock Grid.Row="3" Text="ポート" Style="{StaticResource L}"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Style="{StaticResource Row}" IsEnabled="{Binding EndpointEditable}">
                            <TextBox Width="100" Text="{Binding Port}"/>
                            <RadioButton GroupName="tr" Content="TCP" IsChecked="{Binding UseUdp, Mode=TwoWay, Converter={StaticResource RadioBool}, ConverterParameter=False}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                            <RadioButton GroupName="tr" Content="UDP" IsChecked="{Binding UseUdp, Mode=TwoWay, Converter={StaticResource RadioBool}, ConverterParameter=True}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="4" Text="タイムアウト" Style="{StaticResource L}"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Style="{StaticResource Row}">
                            <TextBox Width="100" Text="{Binding TimeoutMs}"/><TextBlock Text="ms" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Row="5" Text="通信周期" Style="{StaticResource L}"/>
                        <StackPanel Grid.Row="5" Grid.Column="1" Style="{StaticResource Row}">
                            <ComboBox Width="100" ItemsSource="{Binding CommCycleOptions}" SelectedItem="{Binding CommCycleMs}" ItemStringFormat="{}{0} ms"/>
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0" Text="MV・SP読込とPV書込の周期（モデル演算は100 ms）"/>
                        </StackPanel>
                        <TextBlock Grid.Row="6" Text="接続先CPU" Style="{StaticResource L}" Visibility="{Binding ShowSlmpCpuTarget, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel Grid.Row="6" Grid.Column="1" Style="{StaticResource Row}" Visibility="{Binding ShowSlmpCpuTarget, Converter={StaticResource BoolToVis}}">
                            <ComboBox Width="180" ItemsSource="{Binding SlmpCpuTargets}" SelectedValue="{Binding SlmpModuleIo, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="DisplayName"/>
                        </StackPanel>
                        <StackPanel Grid.Row="7" Grid.Column="1">
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Style="{StaticResource BtnSmall}" Content="接続テスト" Command="{Binding TestConnectionCommand}" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0" Text="{Binding ConnectionTestHint}" TextWrapping="Wrap"/>
                            </DockPanel>
                            <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12.5" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource AlarmBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TestOk}" Value="True"><Setter Property="Foreground" Value="{StaticResource RunBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Testing}" Value="True"><Setter Property="Foreground" Value="{StaticResource Ink2Brush}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    <Border Background="{StaticResource ForceBgBrush}" BorderBrush="{StaticResource ForceLineBrush}" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,6,0,0"
                            Visibility="{Binding UseRealPlc, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource ForceBrush}"
                                   Text="実機に切り替えても、制御は自動で開始しません。制御を開始すると、登録したPVアドレスへPLCの実データとして書き込みます。書込先が他の用途で使われていないことを確認してください。"/>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>            <TabItem Header="データ保存">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="CSV保存先" Style="{StaticResource L}"/>
                    <DockPanel Grid.Column="1" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="参照…" Command="{Binding BrowseCsvFolderCommand}" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding CsvFolder}"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="トレンド保持" Style="{StaticResource L}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="70" Text="{Binding TrendMinutesText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="分（1～240 分）" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TrendMinutesError}" Foreground="{StaticResource AlarmBrush}" FontSize="12"/>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="全対象に適用し、100 ms ごとのデータを保持します。短くすると古い履歴を削除します。長くしても削除済みの履歴は戻りません。"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Hint}" TextWrapping="Wrap"
                               Text="プロジェクトファイル（*.psim）には、制御対象一覧・PLCアドレス・レンジ・モデルパラメータ・初期状態・通信設定が保存されます。"/>
                </Grid>
            </TabItem>
            <TabItem Header="アプリ設定">
                <StackPanel>
                    <CheckBox IsChecked="{Binding ConfirmParamChange}" Margin="0,0,0,6">
                        <TextBlock Text="運転中に「急変注意」のパラメータを変更するとき確認する"/>
                    </CheckBox>
                    <TextBlock Style="{StaticResource Hint}" Margin="24,0,0,16" TextWrapping="Wrap"
                               Text="オフにすると確認なしで反映します。PVが急変するとPLC側のPIDが大きく反応するため、通常はオンのままにしてください。"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
