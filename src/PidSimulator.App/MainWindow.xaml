<Window x:Class="PidSimulator.App.MainWindow"
        Icon="/Assets/AppIcon.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PidSimulator.App.ViewModels"
        xmlns:views="clr-namespace:PidSimulator.App.Views"
        Title="{Binding WindowTitle}" Width="1320" Height="880" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource InkBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveProjectAsCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <views:OverviewView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DetailViewModel}">
            <views:DetailView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <!-- メニューバー -->
            <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="16,0" Height="34">
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Hint}">
                        <Run Text="プロジェクト"/> <Run Text="{Binding ProjectLabel, Mode=OneWay}" Foreground="{StaticResource Ink2Brush}"/>
                    </TextBlock>
                    <Menu Background="Transparent" VerticalAlignment="Center" FontSize="13">
                        <MenuItem Header="ファイル(_F)">
                            <MenuItem Header="新規プロジェクト" InputGestureText="Ctrl+N" Command="{Binding NewProjectCommand}"/>
                            <MenuItem Header="プロジェクトを開く…" InputGestureText="Ctrl+O" Command="{Binding OpenProjectCommand}"/>
                            <MenuItem Header="DEMOを開く" Command="{Binding OpenDemoCommand}"/>
                            <MenuItem Header="上書き保存" InputGestureText="Ctrl+S" Command="{Binding SaveProjectCommand}"/>
                            <MenuItem Header="名前を付けて保存…" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveProjectAsCommand}"/>
                            <Separator/>
                            <MenuItem Header="制御対象を登録…" Command="{Binding RegisterCommand}"/>
                            <MenuItem Header="試験データをCSVエクスポート…" Command="{Binding ExportCsvCommand}"/>
                            <Separator/>
                            <MenuItem Header="終了" Command="{Binding ExitCommand}"/>
                        </MenuItem>
                        <MenuItem Header="表示(_V)">
                            <MenuItem Header="制御対象一覧" Command="{Binding BackCommand}"/>
                        </MenuItem>
                        <MenuItem Header="設定(_S)">
                            <MenuItem Header="PLC接続設定…" Command="{Binding OpenSettingsCommand}" CommandParameter="0"/>
                            <MenuItem Header="データ保存…" Command="{Binding OpenSettingsCommand}" CommandParameter="1"/>
                            <MenuItem Header="アプリ設定…" Command="{Binding OpenSettingsCommand}" CommandParameter="2"/>
                        </MenuItem>
                        <MenuItem Header="ヘルプ(_H)">
                            <MenuItem Header="バージョン情報" Command="{Binding AboutCommand}"/>
                        </MenuItem>
                    </Menu>
                </DockPanel>
            </Border>

            <!-- ツールバー -->
            <Border DockPanel.Dock="Top" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="16,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Command="{Binding StopAllCommand}" AutomationProperties.Name="全制御停止"
                            ToolTip="すべての制御対象の演算とPV書込みを停止します">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="10" Height="10" Fill="{StaticResource Ink2Brush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="全制御停止"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="接続" Command="{Binding ConnectPlcCommand}"/>
                        <Button Content="切断" Command="{Binding DisconnectPlcCommand}" Margin="6,0,10,0"/>
                        <Button Style="{StaticResource BtnPrimary}" Content="＋ 制御対象を登録" Command="{Binding RegisterCommand}"/>
                        <Rectangle Width="1" Height="24" Fill="{StaticResource LineBrush}" Margin="10,0"/>
                        <Button Style="{StaticResource BtnGo}" Content="▶ 全制御開始" Command="{Binding StartAllCommand}"/>
                        <Button Style="{StaticResource BtnWarn}" Content="全FORCE解除" Command="{Binding ReleaseAllCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- FORCE警告帯（仕様 §9） -->
            <Border DockPanel.Dock="Top" Background="{StaticResource ForceBgBrush}" BorderBrush="{StaticResource ForceLineBrush}" BorderThickness="0,0,0,1"
                    Visibility="{Binding HasForce, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="16,6">
                    <Border Background="{StaticResource HazardBrush}" Padding="8,1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Border Background="#F2B600" Padding="5,0">
                            <TextBlock Text="FORCE中" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="#17202A"/>
                        </Border>
                    </Border>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmallWarn}" Content="全FORCE解除" Command="{Binding ReleaseAllCommand}"/>
                    <TextBlock Text="{Binding ForceStripText}" Foreground="{StaticResource ForceBrush}" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- ステータスバー -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <DockPanel Margin="16,4">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink2Brush}"/>
                                <Setter Property="Margin" Value="0,0,18,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </StackPanel.Resources>
                        <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource RunBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlcStateKind}" Value="idle"><Setter Property="Fill" Value="{StaticResource Ink3Brush}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding PlcStateKind}" Value="dummy"><Setter Property="Fill" Value="{StaticResource PrevBrush}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding PlcStateKind}" Value="connecting"><Setter Property="Fill" Value="{StaticResource ForceLineBrush}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding PlcStateKind}" Value="alarm"><Setter Property="Fill" Value="{StaticResource AlarmBrush}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding PlcStatusText}" ToolTip="{Binding PlcStatusText}" MaxWidth="560" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlcStateKind}" Value="alarm">
                                            <Setter Property="Foreground" Value="{StaticResource AlarmBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock><Run Text="制御中"/> <Run Text="{Binding RunningCount, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" / "/><Run Text="{Binding TotalCount, Mode=OneWay}"/></TextBlock>
                        <TextBlock><Run Text="FORCE"/> <Run Text="{Binding ForceCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource ForceBrush}"/></TextBlock>
                        <TextBlock><Run Text="異常"/> <Run Text="{Binding AlarmCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AlarmBrush}"/></TextBlock>
                        <TextBlock Text="演算周期 100 ms"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl Content="{Binding CurrentPage}" Focusable="False"/>
        </DockPanel>

        <!-- 操作結果の通知 -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,40" MaxWidth="460"
                Background="{StaticResource InkBrush}" CornerRadius="4" Padding="14,9"
                Visibility="{Binding HasToast, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.25"/></Border.Effect>
            <TextBlock Text="{Binding ToastText}" Foreground="White" FontSize="12.5" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
