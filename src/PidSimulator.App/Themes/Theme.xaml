<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Palette（HTMLモックと同じトークン） ===== -->
    <Color x:Key="BgColor">#E8ECF0</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#E8ECF0"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#F4F6F8"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#EBEFF3"/>
    <SolidColorBrush x:Key="InkBrush" Color="#17202A"/>
    <SolidColorBrush x:Key="Ink2Brush" Color="#445162"/>
    <SolidColorBrush x:Key="Ink3Brush" Color="#737F8C"/>
    <SolidColorBrush x:Key="LineBrush" Color="#CBD2DA"/>
    <SolidColorBrush x:Key="Line2Brush" Color="#E0E5EA"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#1D5C9E"/>
    <SolidColorBrush x:Key="Accent2Brush" Color="#164A80"/>
    <SolidColorBrush x:Key="AccentWeakBrush" Color="#E3ECF6"/>
    <SolidColorBrush x:Key="RunBrush" Color="#16733C"/>
    <SolidColorBrush x:Key="RunBgBrush" Color="#DFF1E5"/>
    <SolidColorBrush x:Key="ForceBrush" Color="#7F5500"/>
    <SolidColorBrush x:Key="ForceBgBrush" Color="#FFF0BF"/>
    <SolidColorBrush x:Key="ForceLineBrush" Color="#DDA400"/>
    <SolidColorBrush x:Key="AlarmBrush" Color="#B3261E"/>
    <SolidColorBrush x:Key="Alarm2Brush" Color="#8E1C16"/>
    <SolidColorBrush x:Key="AlarmBgBrush" Color="#FCE7E5"/>
    <SolidColorBrush x:Key="StopBrush" Color="#5B6775"/>
    <SolidColorBrush x:Key="PrevBrush" Color="#62399A"/>
    <SolidColorBrush x:Key="PrevBgBrush" Color="#EFE8F8"/>
    <SolidColorBrush x:Key="SeriesSpBrush" Color="#3B4755"/>
    <SolidColorBrush x:Key="SeriesPvBrush" Color="#1D5C9E"/>
    <SolidColorBrush x:Key="SeriesMvBrush" Color="#C45E0C"/>

    <FontFamily x:Key="UiFont">Yu Gothic UI, Meiryo UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, BIZ UDGothic, MS Gothic</FontFamily>

    <!-- 危険表示用の黄黒ストライプ -->
    <LinearGradientBrush x:Key="HazardBrush" MappingMode="Absolute" SpreadMethod="Repeat" StartPoint="0,0" EndPoint="8,8">
        <GradientStop Color="#F2B600" Offset="0"/>
        <GradientStop Color="#F2B600" Offset="0.5"/>
        <GradientStop Color="#17202A" Offset="0.5"/>
        <GradientStop Color="#17202A" Offset="1"/>
    </LinearGradientBrush>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- ===== Text ===== -->
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Ink3Brush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Ink2Brush}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="Btn" TargetType="ButtonBase">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                        <Grid>
                            <Border x:Name="hover" CornerRadius="2" Background="#17202A" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hover" Property="Opacity" Value="0.06"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="hover" Property="Opacity" Value="0.14"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Btn}"/>
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Accent2Brush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="BtnGo" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Foreground" Value="{StaticResource RunBrush}"/>
        <Setter Property="BorderBrush" Value="#9CCBAE"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="BtnWarn" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Foreground" Value="{StaticResource ForceBrush}"/>
        <Setter Property="BorderBrush" Value="#E6C766"/>
    </Style>
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Foreground" Value="{StaticResource AlarmBrush}"/>
        <Setter Property="BorderBrush" Value="#E3A7A2"/>
    </Style>
    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style x:Key="BtnSmall" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="BtnSmallWarn" TargetType="Button" BasedOn="{StaticResource BtnWarn}">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource Ink2Brush}"/>
    </Style>
    <Style x:Key="ToggleBtnSmall" TargetType="ToggleButton" BasedOn="{StaticResource Btn}">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentWeakBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Inputs ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="26"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- ===== Progress bar used as range bar ===== -->
    <Style x:Key="RangeBar" TargetType="ProgressBar">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="1"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="3" Background="{StaticResource Surface3Brush}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Tabs ===== -->
    <Style TargetType="TabControl">
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Margin="0,0,0,-1"/>
                        </Border>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,0,1,1" CornerRadius="0,0,4,4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource Ink2Brush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="bd" Padding="14,7" BorderThickness="1,0,1,0" BorderBrush="Transparent" Background="Transparent" CornerRadius="4,4,0,0" Margin="0,0,2,0">
                        <Grid>
                            <Border x:Name="topline" Height="2" VerticalAlignment="Top" Margin="-14,-7,-14,0" Background="{StaticResource AccentBrush}" Visibility="Collapsed" CornerRadius="4,4,0,0"/>
                            <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface3Brush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                            <Setter TargetName="topline" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Ink3Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== DataGrid (event log, force table) ===== -->
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line2Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="RowHeight" Value="28"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink2Brush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Card / panel ===== -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
</ResourceDictionary>
