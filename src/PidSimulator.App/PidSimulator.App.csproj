<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PidSimulator.Core\PidSimulator.Core.csproj" />
    <ProjectReference Include="..\PidSimulator.Plc.Slmp\PidSimulator.Plc.Slmp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PidSimulator</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Product>PID Process Simulator</Product>
    <Version>0.1.0</Version>
    <Company>FA Labo</Company>
    <Authors>FA Labo(fa_yoshinobu)</Authors>
    <Copyright>Copyright (c) 2026 FA Labo</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\AppIcon.png" />
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="PidSimulator.App.LICENSE" />
    <Content Include="..\..\DEMO.psim" Link="DEMO.psim" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
